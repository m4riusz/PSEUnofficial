{
    "targets": {
        "iOS": {
            "type": "application",
            "platform": "iOS",
            "configFiles": {
                "Debug": "../iOS/Configs/Debug.xcconfig",
                "Release": "../iOS/Configs/Release.xcconfig"
            },
            "settings": {
                "INFOPLIST_FILE":"iOS/Configs/Info.plist",
                "PRODUCT_BUNDLE_IDENTIFIER": "$(MYAPP_BUNDLE_IDENTIFIER)",
                "MARKETING_VERSION": "$(MYAPP_APP_VERSION)",
                "CURRENT_PROJECT_VERSION": "$(MYAPP_BUILD_VERSION)",
                "CODE_SIGN_STYLE": "$(MYAPP_CODE_SIGN_STYLE)",
                "DEVELOPMENT_TEAM": "$(MYAPP_TEAM_ID)",
                "CODE_SIGN_IDENTITY": "$(MYAPP_CODE_SIGN_IDENTITY)",
                "PROVISIONING_PROFILE_SPECIFIER": "$(MYAPP_PROVISIONING_PROFILE_SPECIFIER)",
                "OTHER_SWIFT_FLAGS": [
                    "$(inherited)"
                ]
            },
            "sources": [
                {
                    "path": "../iOS/Sources"
                },
                {
                    "path": "../iOS/Resources"
                },
                {
                    "path": "../iOS/Configs/Info.plist"
                }
            ],
            "dependencies": [
                {
					"target": "Core"
				},
				{
					"package": "Swinject",
                    "product": "Swinject-Dynamic"
				}
			],
            "scheme":{
				"gatherCovergageData":true,
				"testTargets":[
					{
						"name":"iOSUnitTests",
						"parallelizable":true,
						"randomExecutionOrder":true
					}
				]
			}
        },
        "iOSUnitTests": {
            "type": "bundle.unit-test",
            "platform": "iOS",
            "settings":{
				"PRODUCT_BUNDLE_IDENTIFIER":"pl.msut.ios.tests.unit",
				"INFOPLIST_FILE":"iOS/Configs/Info-Test.plist",
                "CODE_SIGN_STYLE":"Manual"
			},
            "sources": [
                {
                    "path": "../iOS/Tests",
                    "excludes": [
                        "**/__Snapshots__"
                    ]
                },
                {
                    "path": "../iOS/Configs/Info-Test.plist"
                }
            ],
            "dependencies": [
				{
					"target": "iOS"
				},
				{
					"target": "TestKit"
				}
			],
            "scheme":{
                "gatherCoverageData":true,
				"testTargets":[
					"iOSUnitTests"
				]
			}
        }
    }
}