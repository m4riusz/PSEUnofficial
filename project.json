{
    "name": "PSEUnofficial",
    "options": {
        "bundleIdPrefix": "pl.msut",
        "createIntermediateGroups": true,
        "generateEmptyDirectories": true,
        "groupSortPosition": "top",
        "groupOrdering": [
            {
                "order": [
                    "Sources",
                    "Resources",
                    "Tests",
                    "UITests"
                ],
                "pattern": ".*"
            }
        ],
        "deploymentTarget": {
            "iOS": "17.0"
        }
    },
	"settings": {
		"IPHONEOS_DEPLOYMENT_TARGET": "17.0"
	},
    "include": [
        "xcodegen/packages.json",
        "xcodegen/test_kit.json",
        "xcodegen/core.json",
        "xcodegen/ios.json"
    ]
}